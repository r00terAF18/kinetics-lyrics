<Window x:Class="KineticWallpaper.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#10101A" Focusable="False">
    <Grid IsHitTestVisible="False" Margin="60">
        <TextBlock x:Name="LyricsText" Foreground="#F4F1EA" FontSize="58" FontWeight="Bold"
                   TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                   Text="Waiting for music…"/>
        <StackPanel VerticalAlignment="Bottom" Margin="10,0,0,40">
            <TextBlock x:Name="TrackText" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="SourceText" Foreground="#A0A0B0" FontSize="14" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>
