<Window x:Class="KineticWallpaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinetic Wallpaper" Height="250" Width="480"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="22">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Kinetic Wallpaper — prototype"/>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="Keep this window open while using the wallpaper. Use the console prototype to index music folders. Closing this window restores your previous desktop."/>
        <TextBlock x:Name="Status" Margin="0,12,0,0" TextWrapping="Wrap" Text="Starting…"/>
        <Button Margin="0,14,0,0" Width="110" HorizontalAlignment="Left" Content="Exit" Click="Exit_Click"/>
    </StackPanel>
</Window>
