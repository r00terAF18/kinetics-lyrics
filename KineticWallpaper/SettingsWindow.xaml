<Window x:Class="KineticWallpaper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinetic Lyrics Settings"
        Width="780" Height="650" MinWidth="700" MinHeight="570"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Foreground="#F4F1EA"
        FontFamily="Segoe UI" FontSize="14" Background="#FF1E202F" Topmost="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#191B25" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4D6D" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E6E2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="Background" Value="#20222D" />
            <Setter Property="Foreground" Value="#F4F1EA" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="Background" Value="#20222D" />
            <Setter Property="Foreground" Value="#F4F1EA" />
            <Setter Property="BorderBrush" Value="#383A48" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E6E2" />
            <Setter Property="Margin" Value="0,8,0,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="#252733" />
            <Setter Property="Foreground" Value="#F4F1EA" />
            <Setter Property="BorderBrush" Value="#444653" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Foreground" Value="#E8E6E2" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Kinetic Lyrics" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Wallpaper settings" Foreground="#9B9DAA" Margin="0,3,0,0" />
        </StackPanel>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="#151720" BorderBrush="#30323E">
            <TabItem Header="General" Foreground="Black">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Desktop" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Wallpaper monitor" />
                        <ComboBox x:Name="MonitorCombo" />
                        <TextBlock Text="Display mode" />
                        <ComboBox x:Name="DisplayModeCombo" />
                        <TextBlock Text="Display mode controls how the wallpaper window is attached to Windows." Foreground="#999BA7" TextWrapping="Wrap" Margin="0,-7,0,10" />
                        <Separator Margin="0,10,0,10" Background="#30323E" />
                        <TextBlock Text="On-screen information" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox x:Name="ShowInfoCheck" Content="Show song information HUD" />
                        <CheckBox x:Name="IdleClockCheck" Content="Show the clock while music is idle" />
                        <CheckBox x:Name="Clock24Check" Content="Use a 24-hour clock" Margin="22,0,0,8" />
                        <Separator Margin="0,10,0,10" Background="#30323E" />
                        <CheckBox x:Name="StartupCheck" Content="Start Kinetic Lyrics when I sign in" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lyrics" Foreground="Black">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Lyrics source" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Provider" />
                        <ComboBox x:Name="ProviderCombo" />
                        <TextBlock Text="Embedded audio lyrics and matching .lrc/.txt sidecars are checked first. Automatic searches LRCLIB, Musixmatch, NetEase, QQ Music, and Kugou. Genius opens a song search when synced lyrics are unavailable." Foreground="#999BA7" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <TextBlock Text="Musixmatch API key (optional)" />
                        <PasswordBox x:Name="MusixmatchKeyBox" MaxLength="256" />
                        <TextBlock Text="Stored in this device's local settings and sent to Musixmatch for lyric requests." Foreground="#999BA7" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <TextBlock Text="Global timing offset (milliseconds)" />
                        <TextBox x:Name="OffsetBox" MaxLength="7" ToolTip="Positive values show lyrics earlier; negative values show them later." />
                        <CheckBox x:Name="AutoSyncCheck" Content="Auto-sync lyrics to vocals (experimental)" />
                        <TextBlock Text="You can also fine-tune an individual song with the earlier/later HUD buttons." Foreground="#999BA7" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Visuals" Foreground="Black">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Style preset" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_SelectionChanged" />
                        <TextBlock Text="Choose Custom to edit individual visual options." Foreground="#999BA7" Margin="0,-7,0,14" />
                        <StackPanel x:Name="VisualOptionsPanel">
                            <TextBlock Text="Composition" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="Word layout" />
                            <ComboBox x:Name="LayoutCombo" SelectionChanged="VisualCombo_SelectionChanged" />
                            <TextBlock Text="Transition style" />
                            <ComboBox x:Name="TransitionCombo" SelectionChanged="VisualCombo_SelectionChanged" />
                            <TextBlock Text="Camera" />
                            <ComboBox x:Name="CameraCombo" SelectionChanged="VisualCombo_SelectionChanged" />
                            <TextBlock Text="Background" />
                            <ComboBox x:Name="BackgroundCombo" SelectionChanged="VisualCombo_SelectionChanged" />

                            <TextBlock Text="Adjustments" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,8" />
                            <StackPanel Margin="0,2,0,7">
                                <DockPanel>
                                    <TextBlock Text="Chaos" />
                                    <TextBlock x:Name="ChaosValue" DockPanel.Dock="Right" Foreground="#A7A9B4" />
                                </DockPanel>
                                <Slider x:Name="ChaosSlider" Minimum="0" Maximum="100" ValueChanged="Slider_ValueChanged" Tag="ChaosValue" />
                            </StackPanel>
                            <StackPanel Margin="0,2,0,7">
                                <DockPanel>
                                    <TextBlock Text="Camera movement" />
                                    <TextBlock x:Name="CameraAmountValue" DockPanel.Dock="Right" Foreground="#A7A9B4" />
                                </DockPanel>
                                <Slider x:Name="CameraAmountSlider" Minimum="0" Maximum="100" ValueChanged="Slider_ValueChanged" Tag="CameraAmountValue" />
                            </StackPanel>
                            <StackPanel Margin="0,2,0,7">
                                <DockPanel>
                                    <TextBlock Text="Background dim" />
                                    <TextBlock x:Name="DimValue" DockPanel.Dock="Right" Foreground="#A7A9B4" />
                                </DockPanel>
                                <Slider x:Name="DimSlider" Minimum="0" Maximum="95" ValueChanged="Slider_ValueChanged" Tag="DimValue" />
                            </StackPanel>
                            <StackPanel Margin="0,2,0,7">
                                <DockPanel>
                                    <TextBlock Text="Beat reactivity" />
                                    <TextBlock x:Name="ReactivityValue" DockPanel.Dock="Right" Foreground="#A7A9B4" />
                                </DockPanel>
                                <Slider x:Name="ReactivitySlider" Minimum="0" Maximum="100" ValueChanged="Slider_ValueChanged" Tag="ReactivityValue" />
                            </StackPanel>
                            <StackPanel Margin="0,2,0,7">
                                <DockPanel>
                                    <TextBlock Text="Raise HUD above the taskbar" />
                                    <TextBlock x:Name="HudLiftValue" DockPanel.Dock="Right" Foreground="#A7A9B4" />
                                </DockPanel>
                                <Slider x:Name="HudLiftSlider" Minimum="0" Maximum="30" ValueChanged="Slider_ValueChanged" Tag="HudLiftValue" />
                            </StackPanel>

                            <TextBlock Text="Options" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,5" />
                            <CheckBox x:Name="ChoreoCheck" Content="Song choreography (verse and chorus)" />
                            <CheckBox x:Name="CarryCheck" Content="Carry shared words between lines" />
                            <CheckBox x:Name="MoodCheck" Content="Use song mood to shape the visuals" />
                            <CheckBox x:Name="FlashesCheck" Content="Light bursts and swells" />
                            <CheckBox x:Name="InvertCheck" Content="Invert colours for transparent displays" />
                            <CheckBox x:Name="AutoAccentCheck" Content="Choose accent colour from album art" Checked="AutoAccentCheck_Changed" Unchecked="AutoAccentCheck_Changed" />
                            <TextBlock Text="Manual accent colour (three values from 0 to 1)" Margin="0,7,0,0" />
                            <TextBox x:Name="AccentBox" ToolTip="Example: 1 0.3 0.43" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Performance" Foreground="Black">
                <StackPanel Margin="18">
                    <TextBlock Text="Rendering" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Frame rate" />
                    <ComboBox x:Name="FpsCombo" />
                    <CheckBox x:Name="LowPowerCheck" Content="Reduce animation work to save power" />
                    <TextBlock Text="Lower frame rates reduce GPU use while keeping the lyrics animated." Foreground="#999BA7" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Music Library" Foreground="Black">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Local music folders" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Kinetic Lyrics scans these folders for embedded tags and .lrc sidecar files." Foreground="#999BA7" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <ListBox x:Name="MusicFolderList" Grid.Row="1" Background="#191B25" Foreground="#F4F1EA" BorderBrush="#383A48" Padding="6" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Add folder…" Click="AddFolder_Click" />
                        <Button Content="Remove" Click="RemoveFolder_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="SavedLabel" Text="Changes apply to the wallpaper when saved." Foreground="#999BA7" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Click="Cancel_Click" />
                <Button Content="Save settings" Background="#7C2941" BorderBrush="#B33E5A" FontWeight="SemiBold" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
